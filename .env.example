# YC Directory environment variables
# Copy this file to .env.local and replace every placeholder with your own values.
# Never commit .env, .env.local, or a real token.

# The Sanity dataset must be publicly readable: the browser and server read it
# without a read token. If you need a private dataset, add a read token to the
# Sanity client first.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional. The app falls back to 2025-07-25 when this is unset.
NEXT_PUBLIC_SANITY_API_VERSION="2025-07-25"

# Required for writes: GitHub sign-in author creation, pitch creation, and
# view-count updates. Create an Editor token in the Sanity project settings.
# This value must never be exposed with a NEXT_PUBLIC_ prefix.
SANITY_WRITE_TOKEN=""

# Required by Auth.js. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# GitHub OAuth app credentials. Callback URL for local development:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional, build/CI only. Sentry source-map upload token.
# Omit it locally: builds that upload source maps can take a long time.
# SENTRY_AUTH_TOKEN=""
