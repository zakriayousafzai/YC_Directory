{
  "name": "yc-directory",
  "version": "0.1.0",
  "description": "A Next.js and Sanity directory for publishing and discovering startup pitches.",
  "private": true,
  "license": "MIT",
  "author": "Zakria Khan",
  "homepage": "https://yc-directory-nine-lilac.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakriayousafzai/YC_Directory.git"
  },
  "bugs": {
    "url": "https://github.com/zakriayousafzai/YC_Directory/issues"
  },
  "keywords": [
    "nextjs",
    "sanity",
    "authjs",
    "typescript",
    "tailwindcss",
    "startups",
    "directory"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path=./sanity/extract.json && sanity typegen generate"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "next": "$next",
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@sanity/vision": "^6.20.0",
    "@sentry/nextjs": "^11.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-md-editor": "^4.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "easymde": "^2.21.0",
    "lucide-react": "^0.525.0",
    "markdown-it": "^14.3.3",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "sanity-plugin-markdown": "^9.0.18",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
